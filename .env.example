# Copy this file to .env.local and fill in real values from your Supabase
# project's dashboard: Project Settings > API.
#
# These are the ONLY variables the Next.js app needs. They're all public by
# design (NEXT_PUBLIC_*, shipped to the browser) — Row Level Security is what
# actually protects data, not keeping these secret. Never put a service_role
# key here or in any NEXT_PUBLIC_* variable; Edge Functions get their
# service_role key automatically from Supabase and never read it from this
# app (see supabase/functions/_shared/supabase-admin.deno.ts).

# Project URL — Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (preferred — Project Settings > API Keys > Publishable key).
# Falls back to NEXT_PUBLIC_SUPABASE_ANON_KEY if this is unset (see
# src/lib/supabase/client.ts) for projects still on the legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Legacy anon key — only needed if your project hasn't migrated to
# publishable keys yet. Safe to leave unset otherwise.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
